# Google Maps (ixtiyoriy). Kalit bo'lmasa xarita OpenStreetMap'da ochiladi.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Cloud'da yaratilgan Map ID (ixtiyoriy, custom styling uchun)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# JWT uchun maxfiy kalit (production'da albatta o'zgartiring)
AUTH_SECRET=change-me-to-a-long-random-string

# Tashqi admin panel domeni (CORS). Bo'sh bo'lsa faqat same-origin ishlaydi.
ADMIN_ORIGIN=
